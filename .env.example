# Copy to .env and fill in. Never commit .env.
#
# Leave SQUARE_TOKEN unset and everything runs against the local mock server
# (npm run mock), so you can develop with no Square account at all.

# Sandbox access token — Developer Console > your app > Credentials
SQUARE_TOKEN=

# mock | sandbox | production      (default: mock when no token, else sandbox)
SQUARE_ENV=sandbox

# Location to read sold_out overrides for. Blank = first active location.
SQUARE_LOCATION_ID=

# Webhook signature key — Developer Console > Webhooks > your subscription
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Public HTTPS URL you registered for the webhook (used to verify signatures)
WEBHOOK_NOTIFICATION_URL=

# Optional: fire a GitHub repository_dispatch when the catalog changes
GITHUB_REPO=
GITHUB_TOKEN=

# The React site checkout, for `npm run export:site`
SITE_REPO=

# The site's dev server. When set, the studio's guest tab previews the real
# site instead of Mise's standalone guest.html.
SITE_DEV_URL=
